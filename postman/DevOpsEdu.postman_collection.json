          }
        },
        {
          "name": "Crear servicio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 servicio creado', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const datos = pm.response.json();",
                  "    pm.expect(datos).to.have.property('idServicio');",
                  "    pm.environment.set('idServicio', datos.idServicio);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEstudiante}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Base de datos de practica\",\n  \"descripcion\": \"Servicio de demostracion para la sustentacion\",\n  \"configuracion\": {\n    \"imagenDocker\": \"postgres:16-alpine\",\n    \"cpuAsignado\": 0.5,\n    \"memoriaAsignada\": 256,\n    \"almacenamientoAsignado\": 1024,\n    \"puertos\": [\n      { \"host\": 55432, \"contenedor\": 5432, \"protocolo\": \"tcp\" }\n    ],\n    \"variablesEntorno\": {\n      \"POSTGRES_PASSWORD\": \"clave_de_prueba\"\n    },\n    \"volumenes\": []\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/servicios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "servicios"
              ]
            },
            "description": "RF-05, RF-06: creacion de un servicio con su configuracion inicial. Guarda idServicio automaticamente para los siguientes requests."
          }
        },
        {
          "name": "Listar panel de servicios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEstudiante}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/servicios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "servicios"
              ]
            },
            "description": "RF-16: panel de servicios del usuario autenticado."
          }
        },
