        {
          "name": "Reiniciar servicio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEstudiante}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": ""
            },
            "url": {
              "raw": "{{baseUrl}}/servicios/{{idServicio}}/reiniciar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "servicios",
                "{{idServicio}}",
                "reiniciar"
              ]
            },
            "description": "RF-13: valido desde detenido, en_ejecucion o fallido (RF-19: permite recuperar un servicio marcado fallido cuyo contenedor sigue existiendo, por ejemplo tras detectarse que se detuvo fuera de la plataforma)."
          }
        },
        {
          "name": "Eliminar servicio",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEstudiante}}"
