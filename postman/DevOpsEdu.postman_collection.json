            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Imagenes en Docker\",\n  \"contenido\": [\n    {\n      \"tipo\": \"texto\",\n      \"contenido\": \"Las imagenes son los objetos tipo 'clase' de programas, aplicaciones o servicios que luego se 'instancian' en forma de contenedores.\"\n    },\n    {\n      \"tipo\": \"imagen\",\n      \"url\": \"{{urlImagenModulo}}\",\n      \"textoAlternativo\": \"Diagrama de capas de una imagen Docker\"\n    },\n    {\n      \"tipo\": \"enlace\",\n      \"url\": \"https://docs.docker.com/get-started/docker-concepts/the-basics/what-is-an-image/\",\n      \"titulo\": \"Documentacion oficial: que es una imagen Docker\",\n      \"descripcion\": \"Referencia externa para ampliar el modulo\"\n    }\n  ],\n  \"orden\": 3\n}"
