                  "pm.test('201 imagen subida', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const datos = pm.response.json();",
                  "    pm.expect(datos).to.have.property('url');",
                  "    pm.environment.set('urlImagenModulo', datos.url);",
                  "});"
