            "url": {
              "raw": "{{baseUrl}}/servicios/{{idServicio}}/desplegar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "servicios",
                "{{idServicio}}",
                "desplegar"
              ]
            },
            "description": "RF-11 / CU-05: verifica recursos (RF-09) y crea + inicia el contenedor via Dockerode. Requiere que exista el motor Docker en el host donde corre el backend."
          }
        },
        {
          "name": "Consultar metricas del servicio",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEstudiante}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/servicios/{{idServicio}}/metricas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "servicios",
                "{{idServicio}}",
                "metricas"
              ],
              "query": [
                {
                  "key": "desde",
                  "value": "",
                  "disabled": true
                },
