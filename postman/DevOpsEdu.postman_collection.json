              "mode": "raw",
              "raw": "{\n  \"configuracion\": {\n    \"imagenDocker\": \"postgres:16-alpine\",\n    \"cpuAsignado\": 1,\n    \"memoriaAsignada\": 512,\n    \"almacenamientoAsignado\": 2048,\n    \"puertos\": [\n      { \"host\": 55432, \"contenedor\": 5432, \"protocolo\": \"tcp\" }\n    ],\n    \"variablesEntorno\": {\n      \"POSTGRES_PASSWORD\": \"clave_de_prueba\"\n    },\n    \"volumenes\": []\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/servicios/{{idServicio}}/configuracion",
              "host": [
                "{{baseUrl}}"
              ],
