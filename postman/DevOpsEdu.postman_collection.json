                  "key": "hasta",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "RF-18: historico de metricas de consumo (recolectadas por MonitorPeriodico mientras el servicio esta en_ejecucion). Admite filtro opcional por rango de fechas (desde/hasta)."
          }
