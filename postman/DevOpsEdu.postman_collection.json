                  "pm.test('201 actividad creada', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const datos = pm.response.json();",
                  "    pm.expect(datos).to.have.property('idActividad');",
                  "    pm.environment.set('idActividad1', datos.idActividad);",
                  "});"
