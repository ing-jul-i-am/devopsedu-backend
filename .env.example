# Base de datos de desarrollo
DB_USER=devopsedu
DB_PASSWORD=Test123
DB_NAME=devopsedu
DATABASE_URL=postgresql://devopsedu:Test123@localhost:5432/devopsedu?schema=public

# Base de datos de pruebas
DB_USER_TEST=devopsedu_test
DB_PASSWORD_TEST=Test123
DB_NAME_TEST=devopsedu_test
DATABASE_URL_TEST=postgresql://devopsedu_test:Test123@localhost:5433/devopsedu_test?schema=public

# Autenticacion y servidor
# JWT_SECRET debe tener al menos 16 caracteres y ser secreto en produccion.
JWT_SECRET=
JWT_EXPIRACION_SEGUNDOS=3600
PORT=3000
ROL_POR_DEFECTO=estudiante

# Capacidad del servidor (verificacion de recursos): ruta a inspeccionar para el disco libre
SERVIDOR_RUTA_DISCO=/

# Monitoreo periodico de metricas (ms, maximo 5000 por RNF-09)
MONITOR_INTERVALO_MS=5000

# Origenes del frontend autorizados a consumir la API desde el navegador (CORS),
# separados por comas.
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173
