{
  "name": "devopsedu-backend",
  "version": "0.1.0",
  "description": "Backend de la plataforma educativa para gestion DevOps (DevOpsEdu)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "npm run bd:test:preparar && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run bd:test:preparar && vitest run --coverage",
    "test:unit": "vitest run tests/unitarias",
    "test:integration": "npm run bd:test:preparar && vitest run tests/integracion",
    "bd:test:preparar": "dotenv -e .env -- tsx scripts/preparar-bd-test.ts",
    "bd:test:resetear": "dotenv -e .env -- npx prisma migrate reset --force --skip-seed --schema=prisma/schema.prisma",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/bcrypt": "^6.0.0",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^2.1.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.0",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "dockerode": "^5.0.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "zod": "^3.23.0"
  }
}
